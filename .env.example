# Grade Lens AI Environment Variables Configuration

# Server & Database
PORT=5000
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/gradelens?schema=public
DIRECT_URL=postgresql://postgres:postgrespassword@localhost:5432/gradelens?schema=public
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_gradelens_2026
JWT_REFRESH_SECRET=super_secret_refresh_key_gradelens_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# AI Capabilities (Gemini / OpenAI API Key)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# n8n Automation Engine
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_SYLLABUS_WEBHOOK_ID=syllabus-ingestion
N8N_GRADING_WEBHOOK_ID=answer-sheet-grading

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api
